#: ../../requirements.md:34
msgid "3. Functional Requirements"
msgstr ""

#: ../../requirements.md:35
msgid ""
"REQ-001 [MUST]: sample sensors once per second and send data samples from"
" RM3100, MCP9804/8 within that interval."
msgstr ""

#: ../../requirements.md:37
msgid ""
"REQ-002 [MUST]:  Use GNSS PPS signal to trigger sample transmission and "
"acquisition cadence."
msgstr ""

#: ../../requirements.md:39
msgid "REQ-003 [MUST]:  Data shall be sent as JSON objects."
msgstr ""

#: ../../requirements.md:41
msgid ""
"REQ-004 [SHOULD]: Check GNSS at startup and 1/hour to set local real time"
" clock to maintain timing accuracy."
msgstr ""

